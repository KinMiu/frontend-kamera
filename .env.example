# =============================================================================
# Application Configuration
# =============================================================================
# The title displayed in the browser tab and sidebar branding
VITE_APP_TITLE="Nexus Admin"
# Short description of the application
VITE_APP_DESCRIPTION="Modern & Production-Ready Admin Dashboard Template"
# Application version string
VITE_APP_VERSION="1.0.0"

# =============================================================================
# API & Backend Configuration
# =============================================================================
# Base URL for REST API endpoints
VITE_API_BASE_URL="http://localhost:3000/api"
# Set to 'true' to use in-memory mock database or 'false' for live API
VITE_ENABLE_MOCK="true"

# =============================================================================
# Environment Settings
# =============================================================================
# Current environment: development | staging | production
VITE_APP_ENV="development"
